[Unit]
Description=Cyberbot local River replay research
ConditionPathIsRegular=/opt/cyberbot/var/ai/forward-models-v2.sqlite3

[Service]
Type=oneshot
User=cyberbot
Group=cyberbot
WorkingDirectory=/opt/cyberbot
EnvironmentFile=/etc/cyberbot/research.env
Environment=PYTHONDONTWRITEBYTECODE=1
Environment=OMP_NUM_THREADS=1
Environment=OPENBLAS_NUM_THREADS=1
Environment=MKL_NUM_THREADS=1
ExecStart=/opt/cyberbot/.venv-river/bin/python -m tools.local_research.river_journal --root /opt/cyberbot
TimeoutStartSec=180
MemoryHigh=768M
MemoryMax=1G
CPUQuota=100%
TasksMax=32
Nice=10
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
PrivateNetwork=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/cyberbot/var/ai
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
