# Copy to /etc/cyberbot/obsidian.env as root:root mode 0600.
# Replace placeholders locally. Never commit real identities or credentials.
CYBERBOT_TAILSCALE_ENABLED=1
CYBERBOT_TAILSCALE_HOST=replace-me.example.ts.net
CYBERBOT_TAILSCALE_LOGIN=replace-me@example.invalid
CYBERBOT_TAILSCALE_PORT=8443
CYBERBOT_TAILSCALE_WRITE=0
CYBERBOT_DB=/var/lib/cyberbot/var/paper.sqlite3
CYBERBOT_LEARNING_DB=/var/lib/cyberbot/var/learning.sqlite3
CYBERBOT_WORKER_DB=/var/lib/cyberbot/var/worker.sqlite3
CYBERBOT_SOLANA_READ_ENABLED=0
CYBERBOT_LOCAL_LLM_ENABLED=0
CYBERBOT_CHRONOS_ENABLED=0
CYBERBOT_FX_PROVIDER_ENABLED=0
